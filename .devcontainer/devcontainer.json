{
	// Open this repository in a GitHub Codespace and the live demo is one command
	// away, on GitHub's free 120 core-hours a month with no payment method on
	// file. See docs/05-hosting.md.
	//
	//   uv run sarathi serve
	//
	// then make the port public so a judge can reach it (this cannot be set from
	// devcontainer.json — it is the Ports panel, or):
	//
	//   gh codespace ports visibility 8420:public -c $CODESPACE_NAME
	"name": "SARATHI live demo",
	"image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",

	// uv fetches its own interpreter, so the image's Python version does not have
	// to be the one the lockfile wants.
	"postCreateCommand": "curl -LsSf https://astral.sh/uv/install.sh | sh && $HOME/.local/bin/uv sync --locked",

	"forwardPorts": [8420],
	"portsAttributes": {
		"8420": {
			"label": "SARATHI live demo",
			"onAutoForward": "openBrowser"
		}
	},

	"customizations": {
		"vscode": {
			"extensions": ["ms-python.python", "charliermarsh.ruff"]
		}
	}
}
